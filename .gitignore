# ==============================================================================
# CarLife 车机端工程 —— 忽略清单
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) 工具链：体积巨大（约 740 MB）且全部可重新下载，不入库
#    需要时按 README「工具链」一节重新下载：
#      tools/jdk17.zip  -> JDK 17（apktool / D8 依赖）
#      tools/jadx.zip   -> jadx 1.5.3（反编译 Java 用，非构建必需）
#    apktool.jar / uber-apk-signer.jar 体积小且构建必需 —— 保留，已走 LFS。
# ------------------------------------------------------------------------------
/tools/jdk-17.0.20.1+1/
/tools/jdk17.zip
/tools/jadx/
/tools/jadx.zip
/tools/*.log

# ------------------------------------------------------------------------------
# 2) 构建临时目录：build.sh / 补丁脚本每轮新建，跑完即可回收
#    规则见 AGENTS.md §2「工作约定」
# ------------------------------------------------------------------------------
/_*
!/_apk_git_cleanup.py
/_bw_*/
/_vchk_*/
/_out/
/_build_tmp*

# 反编译转换的中间产物（由 构建日志下载smali.py 重新生成）
/CarLife/02_补丁脚本/logxfer_src/build/

# 反编译工程每轮新建的工作目录（_w129/_w130/_w140…），1441 个 smali/轮，跑完即回收，不入库
/CarLife/01_反编译工程/_w*/

# apktool 的构建输出目录（在工程树内就地 build 会留下它，成品一律走 05_产物）
/CarLife/01_工程源码/*/build/

# ------------------------------------------------------------------------------
# 3) Python / 编辑器噪声
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.idea/
.vscode/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ------------------------------------------------------------------------------
# 4) 其它仓库外的临时产物
# ------------------------------------------------------------------------------
*.apk.idsig.bak
*.tmp
*.bak
