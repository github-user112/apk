<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.boottask" android:versionCode="55" android:versionName="1.6.48">
    <uses-sdk android:minSdkVersion="8" android:targetSdkVersion="19"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- v1.6.46 USB 连接手机事件：部分车机 ROM 要求持本权限才投递 USB 广播 -->
    <uses-permission android:name="android.permission.USB_PERMISSION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <application android:label="开机任务" android:icon="@drawable/ic_launcher" android:allowBackup="false" android:installLocation="internalOnly">
        <activity android:name=".MainActivity" android:label="开机任务" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".EditActivity" android:label="添加规则"/>
        <activity android:name=".AppPickActivity" android:label="选择应用"/>
        <!-- v1.6.42 功能减法：只剩「按键与弹窗」二级页（Root 工具/已排除页/监控页签已删） -->
        <activity android:name=".ToolboxActivity" android:label="按键与弹窗"/>
        <activity android:name=".BootDiagnostics$LogActivity" android:label="日志下载" android:exported="false" android:theme="@android:style/Theme.Black.NoTitleBar"/>
        <!-- v1.6.30 直连免打扰：无障碍服务自动点掉 P2P 配对弹窗。
             v1.6.29 那个 WIFI_P2P_CONNECTION_REQUESTED 接收器已删（4.4 framework 里
             没有这个 action，接收器永不触发，见 P2pAutoAccept 类注释）。 -->
        <service android:name=".P2pDialogClicker" android:label="开机任务·直连自动允许"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service"/>
        </service>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <receiver android:name=".BootAudioReceiver" android:exported="true">
            <intent-filter android:priority="2147483646">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <!-- v1.6.46 USB 连接手机事件：USB_STATE(主机口电源态) + 设备插拔(MTP/PTP/充电档)
             + MEDIA_MOUNTED 路径含 usb(大容量存储档的手机不冒 DEVICE_ATTACHED，只走这里)。
             单独一个 receiver，别往 BootReceiver 加第二个 intent-filter —— 会重复触发 boot 规则。 -->
        <receiver android:name=".UsbPhoneWatcher" android:exported="false"
            android:permission="android.permission.USB_PERMISSION">
            <intent-filter>
                <action android:name="android.intent.action.USB_STATE"/>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED"/>
                <action android:name="android.intent.action.MEDIA_MOUNTED"/>
            </intent-filter>
        </receiver>
        <service android:name=".ExecService"/>
        <service android:name=".P2pGuard"/>
        <service android:name=".HotspotProbe"/>
        <service android:name=".WifiRateProbe"/>
        <service android:name=".ScanCatcher"/>
        <!-- v1.6.44 亿连进程监视：开机自启，记进程出现/消失 + CPU/内存心跳 -->
        <service android:name=".YilianWatcher"/>
    </application>
</manifest>
