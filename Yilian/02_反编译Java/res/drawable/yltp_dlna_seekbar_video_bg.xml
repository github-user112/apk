<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#4dffffff" />
            <corners android:radius="@dimen/dp_4" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/dp_4" />
                <gradient android:startColor="@color/yltp_tab_primary_color" android:endColor="@color/yltp_tab_primary_color" android:angle="0.0" android:centerColor="@color/yltp_tab_primary_color" />
            </shape>
        </clip>
    </item>
</layer-list>
