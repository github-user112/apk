<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="false" android:state_pressed="true">
        <shape>
            <solid android:color="@color/pop_dialog_btn_color_press" />
            <corners android:bottomLeftRadius="@dimen/dp_6" android:bottomRightRadius="@dimen/dp_6" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_pressed="false">
        <shape>
            <solid android:color="@color/pop_dialog_btn_color_default" />
            <stroke android:width="@dimen/dp_2" android:color="@color/yltp_tab_primary_color" />
            <corners android:bottomLeftRadius="@dimen/dp_6" android:bottomRightRadius="@dimen/dp_6" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_pressed="true">
        <shape>
            <solid android:color="@color/pop_dialog_btn_color_press" />
            <stroke android:width="@dimen/dp_2" android:color="@color/yltp_tab_primary_color" />
            <corners android:bottomLeftRadius="@dimen/dp_6" android:bottomRightRadius="@dimen/dp_6" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/pop_dialog_btn_color_default" />
            <corners android:bottomLeftRadius="@dimen/dp_6" android:bottomRightRadius="@dimen/dp_6" />
        </shape>
    </item>
</selector>
