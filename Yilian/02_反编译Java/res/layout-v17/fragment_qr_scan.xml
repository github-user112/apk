    <ImageView android:id="@id/btn_qr_exit" android:background="@drawable/main_activity_back_btn_bg" android:layout_width="@dimen/dp_80" android:layout_height="@dimen/dp_80" android:layout_marginLeft="@dimen/dp_10" android:layout_marginTop="@dimen/dp_16" android:layout_marginStart="@dimen/dp_10" />
