    <TextView android:textSize="@dimen/sp_18" android:textColor="#b3ffffff" android:gravity="center" android:id="@id/fragment_qr_txt3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_20" android:text="@string/qr_txt3" android:layout_below="@id/fragment_qr_help_txt" android:layout_centerHorizontal="true" />
