    <RelativeLayout android:id="@id/fragment_qr_help_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_15" android:layout_below="@id/fragment_qr_bg" android:layout_centerHorizontal="true">
