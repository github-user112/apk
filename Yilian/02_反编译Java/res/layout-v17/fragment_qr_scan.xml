        <TextView android:textSize="@dimen/sp_24" android:textColor="#ffffffff" android:id="@id/fragment_qr_txt2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:maxWidth="@dimen/dp_840" android:text="@string/qr_txt2" android:layout_below="@id/fragment_qr_txt1" android:layout_alignLeft="@id/fragment_qr_txt1" android:layout_centerHorizontal="true" />
