<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView android:id="@id/btn_back" android:background="@drawable/main_activity_back_btn_bg" android:layout_width="@dimen/dp_80" android:layout_height="@dimen/dp_80" android:layout_marginLeft="@dimen/dp_10" android:layout_marginTop="@dimen/dp_16" />
    <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerInParent="true">
        <RelativeLayout android:background="@drawable/qr_border_bg" android:layout_width="@dimen/dp_330" android:layout_height="@dimen/dp_330">
            <RelativeLayout android:background="@drawable/qr_border_bg_white" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="@dimen/dp_12">
                <ImageView android:id="@id/img_qr_code" android:layout_width="@dimen/dp_282" android:layout_height="@dimen/dp_282" android:scaleType="fitXY" android:layout_centerInParent="true" />
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_48">
            <TextView android:textSize="@dimen/sp_24" android:textColor="@color/white_00" android:id="@id/tv_qr_register_confirm_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="@dimen/dp_840" />
            <RelativeLayout android:id="@id/btn_update" android:layout_width="@dimen/dp_58" android:layout_height="@dimen/dp_58">
                <ImageView android:id="@id/img_update" android:background="@drawable/qr_register_update_btn_bg" android:layout_width="@dimen/dp_40" android:layout_height="@dimen/dp_40" android:layout_centerInParent="true" />
            </RelativeLayout>
        </LinearLayout>
        <TextView android:textSize="@dimen/sp_18" android:textColor="@color/white_70" android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_20" android:text="@string/contact_custom_text" />
    </LinearLayout>
    <include layout="@layout/fragment_connection_tip" />
</RelativeLayout>
