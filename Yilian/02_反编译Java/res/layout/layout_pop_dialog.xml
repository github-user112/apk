<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="@drawable/pop_dialog_bg" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/contentContainer" android:layout_width="match_parent" android:layout_height="wrap_content">
        <include android:id="@id/layoutContentCheckbox" android:visibility="gone" layout="@layout/layout_pop_dialog_type_content_checkbox" />
        <include android:id="@id/layoutContent" android:visibility="gone" layout="@layout/layout_pop_dialog_type_content" />
        <include android:id="@id/layoutTitleContent" android:visibility="gone" layout="@layout/layout_pop_dialog_type_title_content" />
        <include android:id="@id/layoutTitleProgress" android:visibility="gone" layout="@layout/layout_pop_dialog_title_progress" />
        <include android:id="@id/layoutTitleContentCheckbox" android:visibility="gone" layout="@layout/layout_pop_dialog_title_content_checkbox" />
    </FrameLayout>
    <FrameLayout android:id="@id/layoutButtons" android:layout_width="match_parent" android:layout_height="@dimen/dp_80">
        <LinearLayout android:orientation="vertical" android:id="@id/layoutTwoButtons" android:layout_width="match_parent" android:layout_height="match_parent">
            <View android:background="@color/pop_dialog_line_color" android:layout_width="match_parent" android:layout_height="@dimen/pop_dialog_line_size" />
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
                <Button android:textSize="@dimen/sp_30" android:textColor="@color/pop_dialog_negative_btn_text_color" android:gravity="center" android:id="@id/btnNegative" android:background="@drawable/pop_dialog_negative_btn_bg_selector" android:layout_width="0.0dp" android:layout_height="match_parent" android:text="negative" android:layout_weight="1.0" android:textAllCaps="false" />
                <View android:background="@color/pop_dialog_line_color" android:layout_width="@dimen/pop_dialog_line_size" android:layout_height="match_parent" />
                <Button android:textSize="@dimen/sp_30" android:textColor="@color/pop_dialog_positive_btn_text_color" android:gravity="center" android:id="@id/btnPositive" android:background="@drawable/pop_dialog_positive_btn_bg_selector" android:layout_width="0.0dp" android:layout_height="match_parent" android:text="positive" android:layout_weight="1.0" android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@id/layoutOneButton" android:layout_width="match_parent" android:layout_height="match_parent">
            <View android:background="@color/pop_dialog_line_color" android:layout_width="match_parent" android:layout_height="@dimen/pop_dialog_line_size" />
            <Button android:textSize="@dimen/sp_30" android:textColor="@color/pop_dialog_positive_btn_text_color" android:gravity="center" android:id="@id/btnOne" android:background="@drawable/pop_dialog_common_btn_bg_selector" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/confirm_txt" android:textAllCaps="false" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
